# 统一换行符：仓库内一律用 LF，避免 Windows 检出后整仓显示为"全部已修改"
* text=auto eol=lf

# 明确文本类型
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# 二进制资源不要做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary

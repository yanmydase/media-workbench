# ===== 服务端密钥（可选，推荐）=====
# 填了这里，浏览器就完全不需要接触 Key；留空则每个设备在自己的"设置"里填。
# ⚠️ 本文件已被 .gitignore 忽略，不要提交到仓库。
DEEPSEEK_API_KEY=

# 上游地址（OpenAI 兼容接口），默认 DeepSeek 官方
UPSTREAM_BASE=https://api.deepseek.com

# 代理访问口令（可选）：设置后，请求需要带 X-Proxy-Token 才能使用 /api 代理
PROXY_TOKEN=

# 额外的 CORS 来源白名单（逗号分隔，可选）
ALLOWED_ORIGINS=

# 端口
PORT=8080
